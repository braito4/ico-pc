# cmake/IcoShardCheck.cmake: -DPROGRAM=<exe> -DSHARDS=<N> [-DARGS=...] -P this file.
# The sharded test's --list-cases names every case with the shard that owns it;
# the shards 1..N together own every case once and none of them is empty.
execute_process(COMMAND "${PROGRAM}" ${ARGS} --shard 1/${SHARDS} --list-cases
                OUTPUT_VARIABLE _out RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "${PROGRAM} --list-cases exited ${_rc}")
endif()
string(REGEX REPLACE "\n$" "" _out "${_out}")
string(REPLACE "\n" ";" _lines "${_out}")
set(_names "")
set(_owned "")
foreach(_l IN LISTS _lines)
    if(NOT _l MATCHES "^([0-9]+) (.+)$")
        message(FATAL_ERROR "unexpected --list-cases line: ${_l}")
    endif()
    if(CMAKE_MATCH_2 IN_LIST _names)
        message(FATAL_ERROR "case ${CMAKE_MATCH_2} listed twice")
    endif()
    list(APPEND _names "${CMAKE_MATCH_2}")
    list(APPEND _owned "${CMAKE_MATCH_1}")
endforeach()
list(LENGTH _names _count)
if(_count EQUAL 0)
    message(FATAL_ERROR "no cases")
endif()
# every N-sized run gives the same owners (a pure function of the table and N)
foreach(_k RANGE 1 ${SHARDS})
    execute_process(COMMAND "${PROGRAM}" ${ARGS} --shard ${_k}/${SHARDS} --list-cases
                    OUTPUT_VARIABLE _again)
    string(REGEX REPLACE "\n$" "" _again "${_again}")
    string(REPLACE "\n" ";" _again "${_again}")
    set(_i 0)
    foreach(_l IN LISTS _again)
        list(GET _names ${_i} _n)
        list(GET _owned ${_i} _o)
        if(NOT _l STREQUAL "${_o} ${_n}")
            message(FATAL_ERROR "shard ${_k}/${SHARDS} lists '${_l}', shard 1 lists '${_o} ${_n}'")
        endif()
        math(EXPR _i "${_i} + 1")
    endforeach()
    if(NOT _i EQUAL _count)
        message(FATAL_ERROR "shard ${_k}/${SHARDS} lists ${_i} cases, not ${_count}")
    endif()
    set(_has 0)
    foreach(_o IN LISTS _owned)
        if(_o EQUAL _k)
            set(_has 1)
        endif()
        if(_o LESS 1 OR _o GREATER ${SHARDS})
            message(FATAL_ERROR "owner ${_o} outside 1..${SHARDS}")
        endif()
    endforeach()
    if(NOT _has)
        message(FATAL_ERROR "shard ${_k}/${SHARDS} owns no case")
    endif()
endforeach()
message(STATUS "${_count} cases over ${SHARDS} shards: every case in exactly one, none empty")
