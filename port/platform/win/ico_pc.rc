/* port/platform/win/ico_pc.rc: ico_pc.exe's resources. The application
   manifest (ico_pc.manifest: the UTF-8 active code page) as resource 1 of
   type RT_MANIFEST (24), the id the loader reads for an executable, and the
   version information (the Details tab of the file's properties, what
   download and security checks read to name the program and its maker).
   ico_version.h is generated by CMake (ICO_VERSION_LABEL). */
#include "ico_version.h"

1 24 "ico_pc.manifest"

1 VERSIONINFO
FILEVERSION ICO_VER_NUMERIC
PRODUCTVERSION ICO_VER_NUMERIC
FILEOS 0x4L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Nathanial Fine"
      VALUE "FileDescription", "ICO PC port"
      VALUE "FileVersion", ICO_VER_TEXT
      VALUE "InternalName", "ico_pc"
      VALUE "LegalCopyright", "Copyright (c) 2026 the ico decompilation contributors"
      VALUE "OriginalFilename", "ico_pc_x64.exe"
      VALUE "ProductName", "ICO PC port"
      VALUE "ProductVersion", ICO_VER_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
